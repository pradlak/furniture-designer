// Konfiguracja Cloudflare Workers: strona statyczna (wynik `npm run build` w katalogu dist/).
// "name" musi być taka sama jak nazwa Workera w panelu Cloudflare.
{
  "name": "furniture-designer",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
