// Konfiguracja Cloudflare Workers: strona statyczna (wynik `npm run build` w katalogu dist/)
// i mały Worker (worker/index.js) do formularza uwag — POST /api/uwagi wysyła maila.
// "name" musi być taka sama jak nazwa Workera w panelu Cloudflare.
{
  "name": "furniture-designer",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker obsługuje tylko /api/* — resztę Cloudflare serwuje prosto z dist/
    "run_worker_first": ["/api/*"]
  },
  // Wysyłanie uwag: na jeden, stały adres (nie można wysłać nigdzie indziej).
  // Wymaga: Email Routing włączonego dla meblesamemu.pl i adresu docelowego zweryfikowanego w Email Routing.
  "send_email": [
    {
      "name": "FEEDBACK",
      "destination_address": "p.radlak@gmail.com"
    }
  ],
  // Konta i projekty w chmurze: baza Cloudflare D1 (tabele w migrations/).
  // database_id — z polecenia `npx wrangler d1 create meblesamemu`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meblesamemu",
      "database_id": "8bac3215-7b1a-4ee5-ad47-a1b710cfc1e8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FEEDBACK_TO": "p.radlak@gmail.com",
    // Logowanie przez Google: identyfikator klienta OAuth (publiczny). Sekret: `npx wrangler secret put GOOGLE_CLIENT_SECRET`.
    "GOOGLE_CLIENT_ID": "782791228145-ablaigscvpqsagmqgsgalr9evh3su4p2.apps.googleusercontent.com"
  }
}
